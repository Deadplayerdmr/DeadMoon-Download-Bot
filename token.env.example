# DeadMoon Download Bot — configuration template
#
# Copy to `token.env` and fill in the values you need. `token.env` holds
# credentials, is listed in .gitignore, and must never be committed.
#
# Every key below is read at request time by utils.get_env_or_token_file(),
# which prefers this file over the process environment. Editing it on the host
# therefore takes effect for the NEXT link you send, without recreating the
# container. The one exception is TELEGRAM_TOKEN, which bot.py reads once at
# import.
#
# Booleans accept 1/0, true/false, yes/no and on/off in any casing. A value the
# parser does not recognise falls back to the documented default, so a typo
# never silently enables a feature.

# ============================================================================
# Telegram
# ============================================================================
# Create a bot with @BotFather and paste its token here.
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Reply language; keys come from langs.json.
BOT_LANG=en
# Your own Telegram numeric user ID. The only ID allowed to administer the
# whitelist, and the one seeded into whitelist.json on first start.
ADMIN_ID=YOUR_TELEGRAM_USER_ID_HERE

# ============================================================================
# Platform switches
# ============================================================================
# One flag per platform. Off means the router refuses that platform's links
# with a short explanation instead of pretending the download failed.
DEEZER_ENABLED=1
QOBUZ_ENABLED=1
TIDAL_ENABLED=1
AMAZON_ENABLED=1
SPOTIFY_ENABLED=1
APPLE_ENABLED=1
# YouTube and SoundCloud go through yt-dlp and need no account.
YOUTUBE_ENABLED=1
SOUNDCLOUD_ENABLED=1

# ============================================================================
# Artist discography downloads
# ============================================================================
# Every provider is opt-in. Artist links are refused before a slot is acquired.
DEEZER_ARTIST_DOWNLOAD_ENABLED=0
QOBUZ_ARTIST_DOWNLOAD_ENABLED=0
TIDAL_ARTIST_DOWNLOAD_ENABLED=0
AMAZON_ARTIST_DOWNLOAD_ENABLED=0
SPOTIFY_ARTIST_DOWNLOAD_ENABLED=0
APPLE_ARTIST_DOWNLOAD_ENABLED=0
YOUTUBE_ARTIST_DOWNLOAD_ENABLED=0
SOUNDCLOUD_ARTIST_DOWNLOAD_ENABLED=0

# ============================================================================
# Cross-platform Deezer ARL fallback
# ============================================================================
# 0 = Disabled (default). Missing credentials or direct-engine failures return
#     an error naming the required credential and engine.
# 1 = Enabled. Failed or uncredentialed requests on other platforms attempt to
#     cross-match the release and download it using the configured DEEZER_TOKEN
#     ARL. No other acquisition provider is used.
FALLBACK_ENABLED=0

# ============================================================================
# Deezer credentials
# ============================================================================
# The `arl` cookie from deezer.com. This is also the last-resort cross-match
# used when FALLBACK_ENABLED=1, so keep it set if you enable fallback.
DEEZER_TOKEN=YOUR_DEEZER_ARL_COOKIE_HERE
# Optional. Supports re-authentication when an ARL expires; use
# /authenticatedeezer <arl> to update the token directly.
DEEZER_USERNAME=YOUR_DEEZER_EMAIL_HERE
DEEZER_PASSWORD=YOUR_DEEZER_PASSWORD_HERE
# Optional HTTP proxy, for a region-restricted catalogue.
DEEZER_PROXY=
# Consecutive failures before the session is rebuilt. 0 disables.
DEEZER_SESSION_REINIT_THRESHOLD=3

# ============================================================================
# Qobuz credentials (streamrip)
# ============================================================================
# Preferred: private multi-field config maintained by /authenticateqobuz.
QOBUZ_CONFIG_PATH=/usr/src/app/local_resources/qobuz_config.toml
# Legacy inline values remain supported and override file values when non-empty.
QOBUZ_USER_AUTH_TOKEN=
QOBUZ_APP_ID=
QOBUZ_USER_ID=
QOBUZ_SECRETS=
QOBUZ_EMAIL=
QOBUZ_PASSWORD=

# ============================================================================
# Tidal credentials (streamrip)
# ============================================================================
# Preferred: private OAuth config maintained by /authenticatetidal.
TIDAL_CONFIG_PATH=/usr/src/app/local_resources/tidal_config.toml
# Legacy inline values remain supported and override file values when non-empty.
TIDAL_USER_ID=
TIDAL_ACCESS_TOKEN=
TIDAL_REFRESH_TOKEN=
TIDAL_TOKEN_EXPIRY=
# ... or the whole blob in one key.
TIDAL_OAUTH_TOKEN=
# Catalogue region to request.
TIDAL_COUNTRY_CODE=US
# Optional alternate API base, for a proxy account.
TIDAL_CUSTOM_API=

# ============================================================================
# Spotify credentials (dotify-cli / direct web Widevine)
# ============================================================================
# Netscape cookies exported from an authorized logged-in open.spotify.com web
# session. The .spotify.com sp_dc cookie is required; a bearer token is not it.
SPOTIFY_COOKIES_PATH=/usr/src/app/local_resources/spotify_cookies.txt
# A provisioned Widevine device. L3 devices are supported when the account and
# release permit them; renaming device.wvd.example does not provision one.
SPOTIFY_WVD_PATH=/usr/src/app/local_resources/device.wvd
# Optional legacy-path adapter: JSON containing {"sp_dc": "..."} is accepted.
# An old Librespot AP username/auth_data file is not valid for this engine.
SPOTIFY_CREDENTIALS_PATH=/usr/src/app/local_resources/spotify_credentials.json
# Retained for config compatibility. OAuth bearer tokens cannot replace sp_dc.
SPOTIFY_OAUTH_TOKEN=
# Native source quality only. ffmpeg stream-copies; no lossy transcoding.
SPOTIFY_AUDIO_QUALITY=aac-high,aac-medium
# Extra pause between album tracks; 0 leaves pacing to the engine.
SPOTIFY_BULK_WAIT_SECONDS=4

# ============================================================================
# Apple Music credentials (gamdl)
# ============================================================================
# A Netscape cookies.txt exported from music.apple.com ...
APPLE_COOKIES_PATH=/usr/src/app/local_resources/apple_cookies.txt
# ... or just the media-user-token value, which is turned into a cookies file.
APPLE_MEDIA_USER_TOKEN=
# Optional comma-separated gamdl 3.9.1 codecs. Blank selects alac,aac-web
# when ENABLE_FLAC=1, otherwise aac-web.
APPLE_CODEC_PRIORITY=

# ============================================================================
# Amazon Music credentials
# ============================================================================
# Both are needed for the direct Amazon engine. See local_resources/README.md
# for the device.wvd provisioning workflow.
AMAZON_DEVICE_TOKEN=
AMAZON_WVD_PATH=/usr/src/app/local_resources/device.wvd
# Optional alternate downloader binary to invoke.
AMAZON_CLI=

# ============================================================================
# Quality & output
# ============================================================================
# 1 = lossless (24-bit/192kHz FLAC where the store offers it), 0 = 320kbps MP3.
ENABLE_FLAC=1
# audio = native audio attachments (default); zip = archive or hosted link.
FORMAT=audio
# Per-track retry budget.
MAX_RETRIES=10
# Attach release art to album and artist messages.
SEND_ALBUM_COVER=1
# Ceiling on one child downloader process (a whole discography).
ENGINE_TIMEOUT_SECONDS=3600
# Parallel track connections streamrip may open.
STREAMRIP_MAX_CONNECTIONS=3

# ============================================================================
# Concurrency
# ============================================================================
# Downloads running at once, across all users.
MAX_CONCURRENT_DOWNLOADS=2
# Requests waiting for a slot. Anything beyond this is refused outright.
MAX_QUEUED_DOWNLOADS=1

# ============================================================================
# Artist download limits
# ============================================================================
# Refuse an artist page with more releases than this, before downloading.
MAX_ARTIST_RELEASES=100
# Seconds between catalogue API calls while paging a discography; avoids 429.
ARTIST_API_DELAY=0.6

# ============================================================================
# File hosting
# ============================================================================
# Server directory the finished archive is copied into, and the public URL it is
# reachable at ({0} is replaced by the hashed archive filename). Leave
# COPY_FILES_PATH blank and every archive is uploaded straight to Telegram,
# split into <48 MB parts when a release is too large for one message.
COPY_FILES_PATH=
FILE_LINK_TEMPLATE=https://example.com/download/{0}
# Optional cookies.txt handed to yt-dlp for YouTube/SoundCloud.
COOKIES_PATH=/usr/src/app/local_resources/cookies.txt

# ============================================================================
# SoundCloud
# ============================================================================
# Optional OAuth token for HQ audio. See the yt-dlp SoundCloud extractor notes.
SOUNDCLOUD_OAUTH_TOKEN=

# ============================================================================
# Auto-delete
# ============================================================================
# Delete the bot's messages AND the staged server files when the timer expires.
AUTO_DELETE_ENABLED=1
# Delay before deletion (1800 = 30 minutes).
AUTO_DELETE_SECONDS=1800
